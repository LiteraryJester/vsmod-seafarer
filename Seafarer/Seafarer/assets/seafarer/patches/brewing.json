[
	// =====================================================================
	// Add corn and coconut variants to base game cider portion
	// =====================================================================
	{ "op": "add", "path": "/variantGroups/0/states/-",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": "corn" },

	{ "op": "add", "path": "/variantGroups/0/states/-",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": "coconut" },

	// Distillation props for new ciders
	{ "op": "addmerge", "path": "/attributes/distillationPropsbytype",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": {
		"ciderportion-corn": {
			"distilledStack": { "type": "item", "code": "spiritportion-corn" },
			"ratio": 0.05
		},
		"ciderportion-coconut": {
			"distilledStack": { "type": "item", "code": "spiritportion-coconut" },
			"ratio": 0.1
		}
	  } },

	// Cider container textures — remove wildcard, add ours, re-add wildcard so ours match first
	{ "op": "remove", "path": "/attributes/waterTightContainerProps/texturebytype/*",
	  "file": "game:itemtypes/liquid/cider.json" },
	{ "op": "addmerge", "path": "/attributes/waterTightContainerProps/texturebytype",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": {
		"*-corn": { "base": "game:block/food/pie/fill-pumpkin", "alpha": 180 },
		"*-coconut": { "base": "seafarer:block/liquid/coconutwater", "alpha": 180 },
		"*": { "base": "game:block/food/pie/fill-{fruit}", "alpha": 180 }
	  } },

	// Cider item textures — same pattern
	{ "op": "remove", "path": "/texturebytype/*",
	  "file": "game:itemtypes/liquid/cider.json" },
	{ "op": "addmerge", "path": "/texturebytype",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": {
		"*-corn": { "base": "game:block/food/pie/fill-pumpkin", "alpha": 180 },
		"*-coconut": { "base": "seafarer:block/liquid/coconutwater", "alpha": 180 },
		"*": { "base": "game:block/food/pie/fill-{fruit}", "alpha": 180 }
	  } },

	// =====================================================================
	// Add corn and coconut variants to base game spirit portion
	// =====================================================================
	{ "op": "add", "path": "/variantGroups/0/states/-",
	  "file": "game:itemtypes/liquid/spirit.json",
	  "value": "corn" },

	{ "op": "add", "path": "/variantGroups/0/states/-",
	  "file": "game:itemtypes/liquid/spirit.json",
	  "value": "coconut" },

	// Spirit container textures
	{ "op": "remove", "path": "/attributes/waterTightContainerProps/texturebytype/*",
	  "file": "game:itemtypes/liquid/spirit.json" },
	{ "op": "addmerge", "path": "/attributes/waterTightContainerProps/texturebytype",
	  "file": "game:itemtypes/liquid/spirit.json",
	  "value": {
		"*-corn": { "base": "game:block/food/pie/fill-pumpkin", "alpha": 100 },
		"*-coconut": { "base": "seafarer:block/liquid/coconutwater", "alpha": 100 },
		"*": { "base": "game:block/food/pie/fill-{fruit}", "alpha": 100 }
	  } },

	// Spirit item textures
	{ "op": "remove", "path": "/texturebytype/*",
	  "file": "game:itemtypes/liquid/spirit.json" },
	{ "op": "addmerge", "path": "/texturebytype",
	  "file": "game:itemtypes/liquid/spirit.json",
	  "value": {
		"*-corn": { "base": "game:block/food/pie/fill-pumpkin", "alpha": 100 },
		"*-coconut": { "base": "seafarer:block/liquid/coconutwater", "alpha": 100 },
		"*": { "base": "game:block/food/pie/fill-{fruit}", "alpha": 100 }
	  } },

	// =====================================================================
	// ExpandedFoods compat: suppress the EF-added Cure transitions for our
	// corn/coconut variants. EF patches game:itemtypes/liquid/cider.json
	// and spirit.json to Cure every variant into
	// expandedfoods:strongwineportion-{fruit} / strongspiritportion-{fruit}
	// respectively, but EF only ships strong* variants for its own fruits
	// — there is no strongwineportion-corn or strongspiritportion-coconut,
	// so the cure transition target fails to resolve and logs a warning.
	//
	// transitionablePropsByType overrides the whole transitionableProps
	// array on a per-variant basis. For cider corn/coconut we keep just
	// the Perish (to vinegar) that EF and vanilla both want; for spirit
	// corn/coconut we drop the only transition (Cure to strongspirit)
	// since vanilla spirit has no Perish to preserve.
	// =====================================================================
	{ "op": "add", "path": "/transitionablePropsByType",
	  "file": "game:itemtypes/liquid/cider.json",
	  "value": {
		"*-corn": [{
			"type": "Perish",
			"freshHours": { "avg": 3360 },
			"transitionHours": { "avg": 144 },
			"transitionedStack": { "type": "item", "code": "game:vinegarportion" },
			"transitionRatio": 1
		}],
		"*-coconut": [{
			"type": "Perish",
			"freshHours": { "avg": 3360 },
			"transitionHours": { "avg": 144 },
			"transitionedStack": { "type": "item", "code": "game:vinegarportion" },
			"transitionRatio": 1
		}]
	  },
	  "dependsOn": [{ "modid": "expandedfoods" }] },

	{ "op": "add", "path": "/transitionablePropsByType",
	  "file": "game:itemtypes/liquid/spirit.json",
	  "value": {
		"*-corn": [],
		"*-coconut": []
	  },
	  "dependsOn": [{ "modid": "expandedfoods" }] }
]
